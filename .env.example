# King's Reach - .env.example (placeholder template)
# Copy to .env and fill in your own values. Never commit .env.
# Every value below is a placeholder. Replace with your own values.
# Windows paths: use forward slashes or escaped backslashes.

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_VALUE_HERE
ALLOWED_CHAT_ID=YOUR_VALUE_HERE
KINGS_REACH_CONFIG=YOUR_VALUE_HERE

# Providers (keys stay here or inside authenticated provider CLIs; routing stores model names only)
OPENAI_API_KEY=YOUR_VALUE_HERE
OPENROUTER_API_KEY=YOUR_VALUE_HERE
OPENROUTER_BASE_URL=YOUR_VALUE_HERE
OLLAMA_BASE_URL=YOUR_VALUE_HERE
NINE_ROUTER_BASE_URL=YOUR_VALUE_HERE
NEXUS_LLM_API_KEY=YOUR_VALUE_HERE
GROQ_API_KEY=YOUR_VALUE_HERE
GOOGLE_API_KEY=YOUR_VALUE_HERE
GEMINI_TEXT_MODEL=YOUR_VALUE_HERE
GEMINI_EMBED_MODEL=YOUR_VALUE_HERE
XAI_API_KEY=YOUR_VALUE_HERE

# Voice
KOKORO_URL=YOUR_VALUE_HERE
TTS_PROVIDER=YOUR_VALUE_HERE
XAI_VOICE=YOUR_VALUE_HERE
XAI_LANG=YOUR_VALUE_HERE
KOKORO_VOICE=YOUR_VALUE_HERE
VOICE_REPLY_DEFAULT=YOUR_VALUE_HERE
WARROOM_VOICE=YOUR_VALUE_HERE
VOICE_MODEL_DIR=YOUR_VALUE_HERE
WHISPER_MODEL=YOUR_VALUE_HERE
WHISPER_DEVICE=YOUR_VALUE_HERE

# Memory
CONSOLIDATION_INTERVAL_MIN=YOUR_VALUE_HERE

# War room
WARROOM_PORT=YOUR_VALUE_HERE
WARROOM_PYTHON=YOUR_VALUE_HERE
WARROOM_AUTOSTART=YOUR_VALUE_HERE
COUNCIL_DEBATE_ROUNDS=YOUR_VALUE_HERE
COUNCIL_INVESTIGATE_TURNS=YOUR_VALUE_HERE
AGENT_BRIDGE_PATH=YOUR_VALUE_HERE

# Dashboard
DASHBOARD_PORT=YOUR_VALUE_HERE
DASHBOARD_TOKEN=YOUR_VALUE_HERE
DASHBOARD_HOST=YOUR_VALUE_HERE

# Scheduler
SCHEDULER_ENABLED=YOUR_VALUE_HERE
SCHEDULER_POLL_MS=YOUR_VALUE_HERE

# Agents
DEFAULT_AGENT_ID=YOUR_VALUE_HERE
AGENT_MAX_TURNS=YOUR_VALUE_HERE

# Display
SHOW_COST_FOOTER=YOUR_VALUE_HERE
MAX_MESSAGE_LENGTH=YOUR_VALUE_HERE

# Misc
LOG_LEVEL=YOUR_VALUE_HERE
NODE_ENV=YOUR_VALUE_HERE
