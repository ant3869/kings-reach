{
  "name": "kings-reach",
  "version": "2.15.3",
  "type": "module",
  "description": "King's Reach - personal AI assistant hub (Telegram + voice + memory v2 + scheduler + WhatsApp + multi-agent + war room + dashboard)",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "skills": "node dist/skill-cli.js",
    "setup:research": "node scripts/setup-research-tools.mjs",
    "research-check": "node scripts/research-check.mjs",
    "test": "tsc && node --experimental-test-module-mocks --test \"tests/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@google/genai": "^1.44.0",
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^4.9.0",
    "grammy": "^1.33.0",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
